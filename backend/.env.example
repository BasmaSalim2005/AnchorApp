# Copy this file to ".env" and fill in your values.

# ---- Database ----
# Paste the Postgres connection string you will provide.
# Example: postgresql://user:password@host:5432/anchor
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/anchor

# Set to "true" if your Postgres provider requires SSL (most cloud providers do).
DATABASE_SSL=false

# ---- Server ----
PORT=3000

# Comma separated list of allowed frontend origins for CORS.
CLIENT_ORIGIN=http://localhost:4200

# ---- Session ----
# Use a long random string in production.
SESSION_SECRET=change-me-to-a-long-random-secret

# Cookie settings. In production behind HTTPS set SESSION_SECURE=true.
SESSION_SECURE=false

# Node environment
NODE_ENV=development
